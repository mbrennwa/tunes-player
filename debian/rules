#!/usr/bin/make -f

SHELL := /bin/sh
.ONESHELL:

%:
	dh $@

override_dh_auto_install:
	set -eu
	# Build an offline wheelhouse and ship it in the .deb.
	# The venv is created on the target machine (postinst) so the Python minor
	# version matches the target system.
	WHEEL_DIR="debian/tunes-player/usr/lib/tunes-player/wheels"
	BUILD_VENV="debian/.build-venv"
	export PYTHONNOUSERSITE=1

	rm -rf "$$WHEEL_DIR" "$$BUILD_VENV"
	mkdir -p "$$WHEEL_DIR"

	python3 -m venv "$$BUILD_VENV"
	"$$BUILD_VENV/bin/python" -m pip install --upgrade pip wheel setuptools

	# Include transitive dependencies (tidalapi needs requests, isodate, etc.).
	if [ -f debian/pypi-requirements.txt ] && [ -s debian/pypi-requirements.txt ]; then
		"$$BUILD_VENV/bin/python" -m pip wheel --wheel-dir "$$WHEEL_DIR" -r debian/pypi-requirements.txt
	fi

	"$$BUILD_VENV/bin/python" -m pip wheel --no-deps --wheel-dir "$$WHEEL_DIR" .

	rm -rf "$$BUILD_VENV"

	if command -v rsvg-convert >/dev/null 2>&1 || command -v inkscape >/dev/null 2>&1; then
		python3 scripts/generate_icons.py --platform linux
	elif [ ! -f build/icons/hicolor/48x48/apps/tunes-player.png ]; then
		echo "No SVG renderer and no pre-built icons. Install librsvg2-bin or run: make icons" >&2
		exit 1
	fi
	install -Dm644 data/tunes.player.desktop debian/tunes-player/usr/share/applications/tunes.player.desktop
	mkdir -p debian/tunes-player/usr/share/icons/hicolor
	cp -a build/icons/hicolor/. debian/tunes-player/usr/share/icons/hicolor/

override_dh_auto_clean:
	dh_auto_clean
	rm -rf debian/.build-venv
